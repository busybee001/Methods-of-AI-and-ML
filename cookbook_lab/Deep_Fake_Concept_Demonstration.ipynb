    "\n",
    "real_face = np.random.rand(128)\n",
    "generated_face = np.random.rand(128)\n",
    "\n",
    "similarity = np.dot(real_face, generated_face)\n",
    "\n",
    "print(\"Deepfake Similarity Score:\")\n",
    "print(round(similarity,2))"

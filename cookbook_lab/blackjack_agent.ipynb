    "import random\n",
    "\n",
    "player = random.randint(12, 21)\n",
    "dealer = random.randint(2, 11)\n",
    "\n",
    "print(\"Player Total:\", player)\n",
    "print(\"Dealer Showing:\", dealer)\n",
    "\n",
    "if player >= 17:\n",
    "    action = \"STAND\"\n",
    "else:\n",
    "    action = \"HIT\"\n",
    "\n",
    "print(\"Agent Action:\", action)"
   ]
